      {
        "id": "n-fbd3fcff-3897-49cb-8454-13dca7884c5a",
        "type": "basic",
        "position": {
          "x": 936.1122350096075,
          "y": 316.6349381736053
        },
        "data": {
          "code": "runJs",
          "label": "Run JS",
          "runJsScript": "let rawText = variables.rd_content;\n\nif (rawText === null || rawText === undefined) {\n  throw new Error(\n    `Không tìm thấy biến content. Các biến hiện có: ${Object.keys(variables).join(\", \")}`\n  );\n}\n\n// Nếu biến content là object JSON\nif (\n  typeof rawText === \"object\" &&\n  rawText.post_content !== undefined\n) {\n  rawText = rawText.post_content;\n}\n\n// Nếu content là chuỗi JSON\nif (typeof rawText === \"string\") {\n  try {\n    const parsed = JSON.parse(rawText);\n\n    if (\n      parsed &&\n      typeof parsed === \"object\" &&\n      parsed.post_content !== undefined\n    ) {\n      rawText = parsed.post_content;\n    }\n  } catch {\n    // Không phải JSON thì giữ nguyên nội dung\n  }\n}\n\nconst convertedText = String(rawText)\n  .replace(/\\\\+r\\\\+n/g, \"\\n\")\n  .replace(/\\\\+n/g, \"\\n\")\n  .replace(/\\\\+r/g, \"\\n\")\n  .replace(/\\\\+t/g, \"\\t\");\n\nreturn convertedText;",
          "isRunning": false,
          "isDone": false,
          "isDimmed": false,
          "lastConfiguredAt": "2026-08-07T05:02:56.400Z",
          "runJsSaveResultTo": "biencontentjs",
          "delayFromSeconds": 3,
          "delayToSeconds": 5
        },
        "measured": {
