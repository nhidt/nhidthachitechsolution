      {
        "data": {
          "code": "gotoUrl",
          "label": "Go to url",
          "gotoUrl": "https://www.ebay.com/",
          "delayFromSeconds": 1,
          "delayToSeconds": 3
        },
        "id": "n-goto-home",
        "type": "basic",
        "position": {
          "x": 120,
          "y": 400
        }
      },
      {
        "data": {
          "code": "runJs",
          "label": "Run JS",
          "runJsScript": "var cats = [\"wireless earbuds\", \"phone case\", \"vintage watch\", \"mechanical keyboard\", \"lego set\", \"coffee maker\", \"running shoes\", \"graphic t-shirt\", \"camera lens\", \"board game\", \"desk lamp\", \"backpack\", \"sunglasses\", \"guitar pedal\", \"action figure\"];\nvar kw = cats[Math.floor(Math.random() * cats.length)];\nvariables.search_keyword = kw;\nreturn \"https://www.ebay.com/sch/i.html?_nkw=\" + encodeURIComponent(kw) + \"&_ipg=60\";",
          "runJsSaveResultTo": "search_url"
        },
        "id": "n-pick-search",
        "type": "basic",
        "position": {
          "x": 200,
          "y": 440
        }
      },
      {
        "data": {
          "code": "gotoUrl",
          "label": "Go to url",
          "gotoUrl": "{{search_url}}",
          "delayFromSeconds": 1,
          "delayToSeconds": 3
        },
        "id": "n-goto-search",
        "type": "basic",
        "position": {
          "x": 280,
          "y": 480
        }
      },
      {
        "data": {
          "code": "waitForSelector",
          "label": "Wait for selector",
          "waitForSelector": ".srp-river-results li.s-card",
          "elementOrderMode": "fixed",
          "elementOrder": 1,
          "nodeTimeoutSeconds": 45
        },
        "id": "n-wait-results",
        "type": "basic",
        "position": {
          "x": 360,
          "y": 520
        }
      },
      {
        "data": {
          "code": "scroll",
          "label": "Scroll",
          "scrollMode": "by",
          "scrollX": 0,
          "scrollY": 600,
          "scrollStepFrom": 300,
          "scrollStepTo": 800,
          "scrollStepDelayFrom": 400,
          "scrollStepDelayTo": 900
        },
        "id": "n-scroll",
        "type": "basic",
        "position": {
          "x": 440,
          "y": 560
        }
      },
      {
        "data": {
          "code": "clickElement",
          "label": "Click Element",
          "clickSelector": "li.s-card a.s-card__link[href*=\"/itm/{{product_item_id}}\"]",
          "elementOrderMode": "fixed",
          "elementOrder": 1,
          "elementOrderFrom": 1,
          "elementOrderTo": 40,
          "delayFromSeconds": 2,
          "delayToSeconds": 4
        },
        "id": "n-click-product",
        "type": "basic",
        "position": {
          "x": 520,
          "y": 600
        }
      },
      {
        "data": {
          "code": "waitForSelector",
          "label": "Wait for selector",
          "waitForSelector": "h1.x-item-title__mainTitle",
          "elementOrderMode": "fixed",
          "elementOrder": 1,
          "nodeTimeoutSeconds": 45
        },
        "id": "n-wait-title",
        "type": "basic",
        "position": {
          "x": 600,
          "y": 640
        }
      },
      {
        "data": {
          "code": "getText",
          "label": "Get text",
          "getTextSelector": "h1.x-item-title__mainTitle",
          "elementOrderMode": "fixed",
          "elementOrder": 1,
          "getTextSaveTo": "product_title"
        },
        "id": "n-get-title",
        "type": "basic",
        "position": {
          "x": 680,
          "y": 680
        }
      },
      {
        "data": {
          "code": "getUrl",
          "label": "Get url",
          "getUrlSaveTo": "product_url"
        },
        "id": "n-get-url",
        "type": "basic",
        "position": {
          "x": 760,
          "y": 720
        }
      },
      {
        "data": {
          "code": "addLog",
          "label": "Add Log",
          "addLogMessage": "eBay: searched \"{{search_keyword}}\" -> opened random product: {{product_title}} | {{product_url}}",
          "addLogIncludeTimestamp": true
        },
        "id": "n-log",
        "type": "basic",
        "position": {
          "x": 840,
          "y": 760
        }
      },
      {
        "data": {
          "code": "pause",
          "label": "Pause",
          "pauseMode": "random",
          "pauseSeconds": 1,
          "pauseRandomFromSeconds": 3,
          "pauseRandomToSeconds": 8
        },
        "id": "n-view",
        "type": "basic",
        "position": {
          "x": 920,
          "y": 800
        }
      },
      {
        "data": {
          "code": "runJs",
          "label": "Run JS",
          "runJsScript": "var links = document.querySelectorAll('.srp-river-results li.s-card:has(.s-card__title) a.s-card__link[href*=\"/itm/\"]');\nvar seen = {}, uniq = [];\nfor (var i = 0; i < links.length; i++) {\n  var m = links[i].href.match(/\\/itm\\/(\\d+)/);\n  if (!m || seen[m[1]]) continue;\n  seen[m[1]] = 1;\n  uniq.push({ el: links[i], id: m[1] });\n}\nif (uniq.length === 0) throw new Error('No product found in the results');\nvar pool = uniq.slice(0, 30);\nvar pick = pool[Math.floor(Math.random() * pool.length)];\npick.el.setAttribute('target', '_self');\nvariables.product_title = '';\nvariables.product_url = '';\nvariables.product_item_id = pick.id;\nreturn pick.id;",
          "runJsSaveResultTo": "product_item_id"
        },
        "id": "n-pick-product",
        "type": "basic",
        "position": {
          "x": 1080,
          "y": 880
        }
      }
    ],
