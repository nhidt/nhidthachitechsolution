      },
      {
        "data": {
          "code": "runJs",
          "label": "Run JS",
          "runJsScript": "var links = document.querySelectorAll('.srp-river-results li.s-card:has(.s-card__title) a.s-card__link[href*=\"/itm/\"]');\nvar seen = {}, uniq = [];\nfor (var i = 0; i < links.length; i++) {\n  var m = links[i].href.match(/\\/itm\\/(\\d+)/);\n  if (!m || seen[m[1]]) continue;\n  seen[m[1]] = 1;\n  uniq.push({ el: links[i], id: m[1] });\n}\nif (uniq.length === 0) throw new Error('No product found in the results');\nvar pool = uniq.slice(0, 30);\nvar pick = pool[Math.floor(Math.random() * pool.length)];\npick.el.setAttribute('target', '_self');\nvariables.product_title = '';\nvariables.product_url = '';\nvariables.product_item_id = pick.id;\nreturn pick.id;",
          "runJsSaveResultTo": "product_item_id"
        },
        "id": "n-pick-product",
        "type": "basic",
        "position": {
          "x": 2280,
          "y": 160
        }
