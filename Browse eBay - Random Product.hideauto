        "data": {
          "code": "runJs",
          "label": "Run JS",
          "runJsScript": "var id = String(variables.product_item_id || '');\nvar links = document.querySelectorAll('a[href*=\"/itm/\"]');\nvar found = false;\nfor (var i = 0; i < links.length; i++) {\n  if (links[i].href.indexOf('/itm/' + id) >= 0) { found = true; break; }\n}\nif (!found) throw new Error('Khong thay san pham trong gio eBay sau khi bam Add to cart (item=' + id + ', url=' + location.href + ')');\nvariables.atc_confirmed = 'yes';\nreturn 'yes';",
          "runJsSaveResultTo": "atc_confirmed",
          "nodeTimeoutSeconds": 30
        },
        "id": "n-check-cart",
        "type": "basic"
