      {
        "data": {
          "code": "runJs",
          "label": "Run JS",
          "runJsScript": "var cats = [\"wireless earbuds\", \"phone case\", \"vintage watch\", \"mechanical keyboard\", \"lego set\", \"coffee maker\", \"running shoes\", \"graphic t-shirt\", \"camera lens\", \"board game\", \"desk lamp\", \"backpack\", \"sunglasses\", \"guitar pedal\", \"action figure\"];\nvar kw = cats[Math.floor(Math.random() * cats.length)];\nvariables.search_keyword = kw;\nreturn \"https://www.ebay.com/sch/i.html?_nkw=\" + encodeURIComponent(kw) + \"&_ipg=60\";",
          "runJsSaveResultTo": "search_url"
        },
        "id": "n-pick-search",
        "type": "basic",
        "position": {
          "x": 1000,
          "y": 160
        }
      },
      {
        "data": {
