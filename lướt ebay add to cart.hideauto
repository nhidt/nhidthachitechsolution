      },
      {
        "position": {
          "x": 20,
          "y": 960
        },
        "data": {
          "code": "waitForSelector",
          "label": "Wait for selector",
          "waitForSelector": ".srp-river-results li.s-card",
          "elementOrderMode": "fixed",
          "elementOrder": 1,
          "nodeTimeoutSeconds": 45
        },
        "id": "n-wait-results",
        "type": "basic"
      },
      {
        "position": {
          "x": 250,
          "y": 960
        },
        "data": {
          "code": "addLog",
          "label": "Add Log",
          "addLogMessage": "[LỖI] Không thấy kết quả tìm kiếm trên eBay (có thể bị chặn hoặc hiện captcha). URL: {{cur_url}}",
          "addLogIncludeTimestamp": true
        },
        "id": "n-no-results",
        "type": "basic"
      },
      {
        "position": {
          "x": -70,
          "y": 1080
        },
        "data": {
          "code": "runJs",
          "label": "Run JS",
          "runJsScript": "var links = document.querySelectorAll('.srp-river-results li.s-card a.s-card__link[href*=\"/itm/\"]');\nvar seen = {}, uniq = [];\nfor (var i = 0; i < links.length; i++) {\n  var m = links[i].href.match(/\\/itm\\/(\\d+)/);\n  if (!m || seen[m[1]]) continue;\n  seen[m[1]] = 1;\n  uniq.push(m[1]);\n}\nif (uniq.length === 0) throw new Error(\"eBay: khong tim thay san pham nao trong ket qua\");\nvar max = Math.min(40, uniq.length);\nvar id = uniq[Math.floor(Math.random() * max)];\nvariables.product_item_id = id;\nreturn id;",
          "runJsSaveResultTo": "product_item_id",
          "nodeTimeoutSeconds": 60
        },
        "id": "n-pick-item",
        "type": "basic"
      },
      {
        "position": {
          "x": 250,
          "y": 1080
        },
        "data": {
