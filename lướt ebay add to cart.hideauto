      },
      {
        "position": {
          "x": -80,
          "y": 500
        },
        "data": {
          "code": "runJs",
          "label": "Run JS",
          "runJsScript": "var cats = [\"wireless earbuds\", \"phone case\", \"vintage watch\", \"mechanical keyboard\", \"lego set\", \"coffee maker\", \"running shoes\", \"graphic t-shirt\", \"camera lens\", \"board game\", \"desk lamp\", \"backpack\", \"sunglasses\", \"guitar pedal\", \"action figure\", \"stainless steel water bottle\", \"usb c cable\"];\nvar kw = cats[Math.floor(Math.random() * cats.length)];\nvariables.key_search = kw;\nvariables.search_url = \"https://www.ebay.com/sch/i.html?_nkw=\" + encodeURIComponent(kw) + \"&_ipg=60&LH_BIN=1\";\nreturn kw;",
          "runJsSaveResultTo": "key_search"
        },
        "id": "n-pick-key",
        "type": "basic"
      },
      {
        "position": {
          "x": 20,
          "y": 620
        },
        "data": {
          "code": "gotoUrl",
          "label": "Go to url",
          "gotoUrl": "{{search_url}}",
          "nodeTimeoutSeconds": 60,
          "delayFromSeconds": 1,
          "delayToSeconds": 3
        },
        "id": "n-goto-search",
        "type": "basic"
      },
      {
        "position": {
          "x": 250,
          "y": 620
        },
        "data": {
          "code": "addLog",
          "label": "Add Log",
          "addLogMessage": "[LỖI] Không mở được trang tìm kiếm eBay. URL: {{search_url}}",
