      {
        "position": {
          "x": -45,
          "y": 2400
        },
        "data": {
          "code": "getUrl",
          "label": "Get url",
          "getUrlSaveTo": "cur_url"
        },
        "id": "n-get-done-url",
        "type": "basic"
      },
      {
        "position": {
          "x": -55,
          "y": 2520
        },
        "data": {
          "code": "runJs",
          "label": "Run JS",
          "runJsScript": "var count = '';\nvar els = document.querySelectorAll('#gh-cart-n, .gh-cart__count, .gh-cart .badge, .gh-cart__icon');\nfor (var i = 0; i < els.length; i++) {\n  var t = (els[i].textContent || '').replace(/\\s+/g, ' ').trim();\n  var m = t.match(/\\d+/);\n  if (m) { count = m[0]; break; }\n}\nvariables.cart_count = count || '0';\nvar body = (document.body && document.body.innerText ? document.body.innerText : '').toLowerCase();\nvar url = location.href.toLowerCase();\nvar ok = false;\nif (count && parseInt(count, 10) > 0) { ok = true; }\nif (body.indexOf('added to cart') >= 0 || body.indexOf('added to your cart') >= 0) { ok = true; }\nif (url.indexOf('cart.payments.ebay.com') >= 0 || url.indexOf('cart.ebay.com') >= 0) { ok = true; }\nvariables.atc_confirmed = ok ? 'yes' : 'no';\nif (!ok) { throw new Error('Chua xac nhan duoc san pham trong gio eBay (badge=' + (count || '0') + ', url=' + location.href + ')'); }\nreturn variables.atc_confirmed;",
          "runJsSaveResultTo": "cart_count",
          "nodeTimeoutSeconds": 30
        },
        "id": "n-check-cart",
        "type": "basic"
      },
      {
        "position": {
          "x": -55,
          "y": 2640
        },
        "data": {
          "code": "addLog",
          "label": "Add Log",
          "addLogMessage": "[XONG] Đã thêm vào giỏ: {{product_title}} | Xác nhận trên trang: {{atc_confirmed}} | Số món trong giỏ: {{cart_count}} | URL: {{cur_url}}",
          "addLogIncludeTimestamp": true
