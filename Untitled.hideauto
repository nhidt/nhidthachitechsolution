      {
        "id": "n-random-kw",
        "type": "basic",
        "position": {
          "x": 60,
          "y": 460
        },
        "data": {
          "code": "runJs",
          "label": "Run JS",
          "runJsScript": "var keywords = ['nhạc lofi chill','cách nấu phở ngon','du lịch đà nẵng','mẹo vệ sinh nhà cửa','học tiếng anh giao tiếp','bài tập thể dục buổi sáng','review điện thoại mới','tin tức công nghệ','phim hoạt hình thiếu nhi','nhạc thiền thư giãn','cách trồng cây trong nhà','công thức nấu ăn gia đình','thủ thuật máy tính','bóng đá việt nam','cách tiết kiệm tiền','karaoke thiếu nhi','hướng dẫn photoshop','nuôi dạy con','xe điện','cà phê pha máy'];\nvar k = keywords[Math.floor(Math.random() * keywords.length)];\nvariables.keyword = k;\nvariables.keyword_url = encodeURIComponent(k);\nreturn k;",
          "nodeTimeoutSeconds": 30,
          "runJsSaveResultTo": "keyword"
        }
      },
