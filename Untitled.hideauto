        "data": {
          "code": "runJs",
          "label": "Run JS",
          "runJsScript": "var list = document.querySelectorAll(\"ytd-video-renderer a#video-title\");\nvar max = Math.min(6, list.length);\nvar i = max > 0 ? Math.floor(Math.random() * max) + 1 : 1;\nvariables.video_index = String(i);\nreturn i;",
          "nodeTimeoutSeconds": 30,
          "runJsSaveResultTo": "video_index"
        }
      },
