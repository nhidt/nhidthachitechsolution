      {
        "id": "n-play-video",
        "type": "basic",
        "position": {
          "x": 60,
          "y": 1630
        },
        "data": {
          "code": "runJs",
          "label": "Run JS",
          "runJsScript": "try {\n  var v = document.querySelector(\"video.html5-main-video\") || document.querySelector(\"#movie_player video\");\n  if (!v) return \"khong-thay-video\";\n  var p = v.play();\n  if (p && p.catch) p.catch(function () { try { v.muted = true; v.play(); } catch (e) {} });\n  return \"dang-phat\";\n} catch (e) { return \"loi:\" + String(e && e.message ? e.message : e); }",
          "nodeTimeoutSeconds": 30,
          "runJsSaveResultTo": "play_state"
        }
      },
