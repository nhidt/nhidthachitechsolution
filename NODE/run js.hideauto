          "label": "Run JS",
          "runJsScript": "const w = window.open(\"https://www.ebay.com\", \"_blank\");\n\nconst timer = setInterval(() => {\n    try {\n        if (w.document.readyState === \"complete\") {\n            clearInterval(timer);\n\n            setTimeout(() => {\n                const el = w.document.querySelector(\"#vl-flyout-nav > ul > li:nth-child(6) > a\");\n                if (el) el.click();\n            }, 5000);\n        }\n    } catch (e) {\n        // Chờ trang tải xong\n    }\n}, 500);",
