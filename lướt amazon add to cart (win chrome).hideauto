        "data": {
          "code": "runJs",
          "label": "Run JS",
          "runJsScript": "const keys = [\"wireless earbuds\", \"stainless steel water bottle\", \"usb c cable 3 pack\", \"reusable shopping bags\", \"led desk lamp\", \"yoga mat\"];\nconst k = keys[Math.floor(Math.random() * keys.length)];\nvariables.key_search = k;\nreturn k;",
          "runJsSaveResultTo": "key_search"
        }
      },
