          "code": "start",
          "label": "Start"
        }
      },
      {
        "id": "n-open-connect",
        "position": {
          "x": 360,
          "y": 160
        },
        "type": "basic",
        "data": {
          "code": "openConnect",
          "label": "Open & Connect",
          "openConnectMode": "defaultProfile",
          "openConnectCloseWhenDone": false,
          "openConnectFingerprintBrowserVersionAuto": true,
          "openConnectFingerprintWebview": false,
          "openConnectFingerprintHardwareConcurrencyAuto": true,
          "openConnectFingerprintHardwareConcurrency": 8,
          "openConnectFingerprintDeviceMemoryAuto": true,
          "openConnectFingerprintDeviceMemory": 8,
          "openConnectFingerprintPhysicalMemoryAuto": true,
          "openConnectFingerprintPhysicalMemory": 16,
          "openConnectFingerprintMaxTouchPointsAuto": true,
          "openConnectFingerprintScreenSizeMode": "realDevice",
          "openConnectFingerprintComputerNameAuto": true,
          "openConnectFingerprintMacAddressAuto": true,
          "openConnectFingerprintTimezoneFillByIp": true,
          "openConnectFingerprintTimezone": "UTC",
          "openConnectFingerprintGeolocationMode": "prompt",
          "openConnectFingerprintGeolocationFillByIp": true,
          "openConnectFingerprintGeoAccuracy": 100,
          "openConnectFingerprintLanguageMode": "fillBaseIp",
          "openConnectFingerprintUserAgentAuto": true,
          "openConnectFingerprintWebglMetaAuto": true,
          "openConnectFingerprintWebGpu": true,
          "openConnectFingerprintCanvasMode": "off",
          "openConnectFingerprintNoiseAudio": false,
          "openConnectFingerprintNoiseWebglImage": false,
          "openConnectFingerprintNoiseWebglParam": false,
          "openConnectFingerprintNoiseCodecs": false,
          "openConnectFingerprintNoiseFonts": false,
          "openConnectFingerprintDisableImage": false,
          "openConnectFingerprintNoiseClientRects": "off",
          "openConnectFingerprintMediaDeviceMode": "noise",
          "openConnectFingerprintSwiftShader": false,
          "openConnectFingerprintWebgl2": true,
          "openConnectFingerprintRestoreSession": false,
          "openConnectFingerprintDisableAutofill": false,
          "openConnectFingerprintHideProfileName": false,
          "openConnectFingerprintAkamaiBypassDns": false,
          "openConnectFingerprintDisableCssAnimation": false,
          "openConnectFingerprintDisableTrackingProtection": false,
          "openConnectFingerprintDisableAiMode": false,
          "openConnectFingerprintDisableAvatar": false,
          "openConnectFingerprintDisablePasskey": true,
          "openConnectFingerprintTranslate": false,
          "openConnectFingerprintAutoAcceptExt": false,
          "openConnectFingerprintDisableWindowHello": false,
          "openConnectFingerprintAllowPopups": false,
          "openConnectFingerprintDisableMachineId": false,
          "openConnectFingerprintIncognito": false,
          "openConnectFingerprintWebrtcMode": "altered",
          "openConnectFingerprintWebrtcFillByIp": true,
          "openConnectFingerprintPortToProtectAuto": true,
          "openConnectFingerprintSecureDns": false,
          "openConnectFingerprintSecureDnsProvider": "cloudflare",
          "openConnectFingerprintCustomNetworkMode": "noise",
          "openConnectFingerprintNetworkEffectiveType": "default",
          "openConnectFingerprintNetworkType": "default",
          "openConnectFingerprintNetworkCustomEffectiveType": "4g",
          "openConnectFingerprintNetworkSaveData": false,
          "openConnectFingerprintBluetooth": false,
          "openConnectFingerprintDoNotTrack": false,
          "openConnectFingerprintMicrophonePermission": "default",
          "openConnectFingerprintCameraPermission": "default",
          "openConnectFingerprintClipboardPermission": "ask",
          "openConnectFingerprintNotificationPermission": "ask",
          "openConnectFingerprintSavePasswords": "ask",
          "openConnectFingerprintReplaceBatteryState": false,
          "openConnectFingerprintQuicProtocol": "default",
          "openConnectProxyEnabled": false
        }
      },
      {
        "id": "n-goto-home",
        "type": "basic",
        "position": {
          "x": 680,
          "y": 160
        },
        "data": {
          "code": "gotoUrl",
          "label": "Go to url",
          "gotoUrl": "https://www.youtube.com"
        }
      },
      {
        "id": "n-wait-home",
        "type": "basic",
        "position": {
          "x": 1000,
          "y": 160
        },
        "data": {
          "code": "waitForSelector",
          "label": "Wait for selector",
          "waitForSelector": "a[href*=\"/watch\"]",
          "elementOrderMode": "fixed",
          "elementOrder": 1
        }
      },
      {
        "id": "n-loop",
        "type": "loop",
        "position": {
          "x": 1320,
          "y": 160
        },
        "data": {
          "code": "loop",
          "label": "Loop",
          "loopMode": "times",
          "loopTimes": 5,
          "loopIndexVariable": "vid_index"
        }
      },
      {
        "id": "n-pick-video",
        "type": "basic",
        "position": {
          "x": 1320,
          "y": 440
        },
        "data": {
          "code": "runJs",
          "label": "Run JS",
          "runJsScript": "var links = document.querySelectorAll(\"a[href*=\\\"/watch\\\"]\");\nvar urls = [];\nfor (var i = 0; i < links.length; i++) {\n  var h = links[i].href || \"\";\n  if (h.indexOf(\"/watch\") === -1) continue;\n  if (urls.indexOf(h) === -1) urls.push(h);\n}\nif (urls.length === 0) {\n  variables.pick_status = \"empty\";\n  variables.video_url = \"\";\n  return \"\";\n}\nvar pick = urls[Math.floor(Math.random() * urls.length)];\nvariables.video_url = pick;\nvariables.pick_status = \"ok\";\nreturn pick;"
        }
      },
      {
        "id": "n-check-url",
        "type": "if",
        "position": {
          "x": 1640,
          "y": 440
        },
        "data": {
          "code": "if",
          "label": "IF",
          "ifConditions": [
            {
              "id": "c-empty",
              "leftValue": "{{pick_status}}",
              "operator": "equals",
              "rightValue": "ok",
              "logicalOperator": "AND"
            }
          ]
        }
      },
      {
        "id": "n-goto-video",
        "type": "basic",
        "position": {
          "x": 1960,
          "y": 440
        },
        "data": {
          "code": "gotoUrl",
          "label": "Go to url",
          "gotoUrl": "{{video_url}}",
          "nodeTimeoutSeconds": 120
        }
      },
      {
        "id": "n-wait-player",
        "type": "basic",
        "position": {
          "x": 2280,
          "y": 440
        },
        "data": {
          "code": "waitForSelector",
          "label": "Wait for selector",
          "waitForSelector": "#movie_player video, video.html5-main-video",
          "elementOrderMode": "fixed",
          "elementOrder": 1,
          "nodeTimeoutSeconds": 120
        }
      },
      {
        "id": "n-get-url",
        "type": "basic",
        "position": {
          "x": 2600,
          "y": 440
        },
        "data": {
          "code": "getUrl",
          "label": "Get url",
          "getUrlSaveTo": "cur_url"
        }
      },
      {
        "id": "n-get-title",
        "type": "basic",
        "position": {
          "x": 2920,
          "y": 440
        },
        "data": {
          "code": "runJs",
          "label": "Run JS",
          "runJsScript": "return document.title.replace(/ - YouTube$/, \"\")",
          "runJsSaveResultTo": "video_title"
        }
      },
      {
