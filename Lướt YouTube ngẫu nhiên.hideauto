          "y": 440
        },
        "data": {
          "code": "addLog",
          "label": "Add Log",
          "addLogMessage": "Đang xem video {{vid_index}}: {{video_title}} | {{cur_url}}",
          "addLogIncludeTimestamp": true
        }
      },
